<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pruebas de la lógica del ícono (bandeja/Estado.cs), sin ventanas:  dotnet run --project bandeja\pruebas -c Release
       Termina con código distinto de 0 si alguna falla. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>NexoMesa.Bandeja.Pruebas</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Estado.cs" Link="Estado.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
